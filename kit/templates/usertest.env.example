# Read by loopkit/run.sh when the features run out: automatic user test (testers with a browser, one per zone,
# on an isolated copy; then a triage turns their findings into features). Usually written by the planner.
# The copy runs from the repo itself (the loop is idle at that moment) with its data in $USERTEST_DATA.
USERTEST_PORT=3400                   # not 8090, DEMO_PORT or any port the tests use
USERTEST_HEALTH=/api/health          # path answering 200 when the copy is ready
USERTEST_BUILD='npm run build'
USERTEST_SEED='DB_PATH="$USERTEST_DATA/app.db" npm run seed'                          # never the demo's data
USERTEST_START='DB_PATH="$USERTEST_DATA/app.db" PORT="$USERTEST_PORT" exec node dist/server.js'   # foreground
USERTEST_INFO='Accounts demo@example.com / demo1234 and admin@example.com / admin1234. Emails go to the dev mailbox at /dev/mailbox. Playwright: write .cjs scripts and run them with NODE_PATH=<repo>/node_modules node script.cjs.'
USERTEST_ZONES=(                     # one tester per zone, 3-5, no overlaps: "name|what to test"
  "accounts|Landing, sign-up with email verification, log-in, password reset, settings, legal pages and 404."
  "core|The main feature end to end, with two users at once. SPEC section 4. Designs: docs/design/screens/."
  "content|Posting, editing, deleting, search, notifications and the admin panel."
  "polish|Themes, languages, responsive layout at 360 px, accessibility (axe), offline and install (PWA)."
)
