# loop-kit settings for this project. Copy to loopkit.env (git-ignored: it may hold tokens) and adjust.
# Environment variables win over this file. Full reference: docs/configuration.md in the loop-kit repo.

# --- Models and permissions ---------------------------------------------------------------------
MODEL=opus                     # worker model (empty = Claude Code's default). Aliases: opus, sonnet, haiku
#QA_MODEL=sonnet               # cheaper QA if you are short on quota (default: same as MODEL)
#REPLAN_MODEL=                 # default: same as MODEL
#USERTEST_MODEL=               # testers and triage (default: QA_MODEL)

# Only inside an isolated, disposable VM or container (see docs/isolation.md):
#PERMS="--dangerously-skip-permissions"
# Default: Claude Code's auto permission mode (safer, but some actions may be refused and the worker may get stuck)
#PERMS="--permission-mode auto"

# --- Limits ---------------------------------------------------------------------------------------
#BUDGET_USD=200                # stop when the agents' reported cost reaches this (API-equivalent on subscriptions)
#VERIFY_TIMEOUT=20m            # per verify command; raise it (e.g. 45m) when e2e suites grow
#ITER_TIMEOUT=3h               # per agent session
#MAX_TURNS=300                 # per agent session
#MAX_ATTEMPTS=3                # failures per feature before replanning
#STALL_LIMIT=6                 # iterations without progress before replanning
#MAX_REPLANS=5                 # replans in a row without progress before halting for a human
#REGRESSION_EVERY=10           # re-run every verify after N new passing features (0 = never)
#USERTEST_ROUNDS=2             # automatic user-test rounds when the work runs out (0 = never; needs usertest.env)
#USERTEST_TIMEOUT=90m          # per tester

# --- Notifications (all optional; everything also lands in logs/notify.log) -----------------------
#NTFY_TOPIC=a-long-secret-topic-name          # push to your phone with the ntfy app (https://ntfy.sh)
#NTFY_SERVER=https://ntfy.sh                  # or your self-hosted ntfy
# Any command; it gets the message as $1. Examples in the loop-kit repo (examples/notify/):
#NOTIFY_CMD="$HOME/loop-kit/examples/notify/telegram.sh"
#TELEGRAM_BOT_TOKEN=123456:ABC...             # used by telegram.sh (exported so the command sees it)
#TELEGRAM_CHAT_ID=123456789
#export TELEGRAM_BOT_TOKEN TELEGRAM_CHAT_ID
