# Read by loopkit/demo.sh: an always-up-to-date copy of the app, built from the latest passing feature in a clone
# next to the repo (<project>-demo). Usually written by the planner (prompts/PLAN.md). Plain shell.
DEMO_PORT=3000                                  # not 8090 (roadmap) nor any port the tests use
DEMO_INSTALL='npm ci --no-audit --no-fund'      # re-run when a lockfile changes (DEMO_INSTALL_PATHS: regex of files)
DEMO_BUILD='npm run build'                      # required
DEMO_START='node dist/server.js'                # required; foreground; reads $PORT
DEMO_RESEED='rm -f .demo/demo.db && npm run seed'   # creates demo data from scratch (keep it inside the folder)
DEMO_RESEED_PATHS='^src/seed/'                  # if a new commit touches these paths, demo data is recreated
DEMO_LOGIN='demo@example.com / demo1234'        # printed when it starts
#DEMO_DIR=/srv/myapp-demo                       # where the clone lives (default: <project>-demo)
export DB_PATH=.demo/demo.db DEMO_MODE=1        # whatever your app needs in demo mode
